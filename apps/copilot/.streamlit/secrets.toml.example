# Copy to secrets.toml locally. Never commit populated credentials.
COPILOT_CUSTOMER_NAME = "Demo Customer"
PAF_ORIGIN = ""
PAF_AGENT_ID = ""
PAF_ROOM_PATH = "roomId"
# PAF_API_KEY = "set-locally"
# PAF_ENDPOINT = "https://your-paf-host/your-copied-agent-route"

# Copy the deployed agent's A2A URL, not its browser or chat URL.
AIDP_ENDPOINT = ""
AIDP_AUTH = "OCI API key profile"
AIDP_OCI_PROFILE = "DEFAULT"
AIDP_OCI_CONFIG = "~/.oci/config"
AIDP_TIMEOUT = "600"
# AIDP_DISPLAY_NAME = "Custom investigation desk"
# AIDP_AUTH = "OCI security-token profile"
# Or, only if this deployment accepts OAuth:
# AIDP_AUTH = "OAuth bearer token"
# AIDP_BEARER_TOKEN = "set-locally"
# AIDP_DH_USER_PRINCIPAL = "deployment-approved-value-if-required"
